# Supabase — same project the Make.com pipeline writes to.
# Safe to expose: this is the publishable (anon) key, gated by your RLS policies.
NEXT_PUBLIC_SUPABASE_URL=https://etduovglrefjxotzypua.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_iHTTar0UlHZEVpNU0s6ukA_iYMhSzD0

# Password for the /admin dashboard. CHANGE THIS before deploying.
ADMIN_PASSWORD=change-me-to-something-strong

# Public site base URL (used for canonical URLs, sitemap, OG tags).
# Set to your live domain on Netlify, e.g. https://your-site.netlify.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Pexels API key — used to fetch a topically relevant photo per article
# (searched by primary_keyword/category). Free, instant signup at
# https://www.pexels.com/api/. Omit this and the site falls back to a
# stable but generic placeholder photo per article.
PEXELS_API_KEY=
